# This pick PC's lines, merged over the shipped cell profile (perception/cells/<cell>.env)
# into /etc/perception/cell.env by install.sh. Plain KEY=VALUE only: no quotes, no inline
# comments, no $ — systemd's EnvironmentFile= and perception's cell parser must agree.
# Only variables the perception/urctl code reads (tests/test_deploy_pi.py checks that).
#
# The SDK built by install.sh (librealsense v2.58.4, RSUSB backend).
REALSENSE_LIB=/opt/librealsense/lib/librealsense2.so
# The hand-eye file `perception calibrate --apply` / the cockpit's Apply write and read
# (the service's working directory is /var/lib/perception, so captures/ lands there too).
PERCEPTION_HANDEYE_FILE=/var/lib/perception/captures/calibration/handeye.json
# The structured JSON log of every robot action (urctl.audit), one record per line.
UR_AUDIT_LOG=/var/lib/perception/audit.jsonl
